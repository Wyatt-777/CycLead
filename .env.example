# Copy this file to .env for local-only configuration. Do not commit .env.
CYCLELEAD_ENVIRONMENT=development
CYCLELEAD_DATABASE_URL=sqlite:///data/cyclelead.db
CYCLELEAD_QUALIFICATION_THRESHOLD=60

# Optional official public-web source. Keep the API key only in your local .env.
CYCLELEAD_BRAVE_SEARCH_API_KEY=
CYCLELEAD_BRAVE_SEARCH_COUNTRY=US
CYCLELEAD_BRAVE_SEARCH_LANGUAGE=en
CYCLELEAD_BRAVE_SEARCH_RESULT_COUNT=10
CYCLELEAD_BRAVE_SEARCH_TIMEOUT_SECONDS=10
